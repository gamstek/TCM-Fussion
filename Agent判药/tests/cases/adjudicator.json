{
  "_comment": "影子仲裁用例数据。decision 用紧凑参数 {verdict, c1, c2}（runner 用 construct_decision 展开为 canonical decision，含两条候选，cand1='候选一'/id=cand1，cand2='候选二'/id=cand2）。client_result 为 fake arbitrate() 返回值（null 表示 client=None）。checks.kind 为断言语义。",
  "checks": [
    {"name": "带内触发：probable + 分差0.05<0.10",
     "kind": "should_arbitrate", "decision": {"verdict": "probable", "c1": 0.60, "c2": 0.55}, "expect": true},
    {"name": "confirmed 不触发（不在介入带）",
     "kind": "should_arbitrate", "decision": {"verdict": "confirmed", "c1": 0.80, "c2": 0.75}, "expect": false},
    {"name": "分差=0.10 不触发（严格小于）",
     "kind": "should_arbitrate", "decision": {"verdict": "probable", "c1": 0.60, "c2": 0.50}, "expect": false},
    {"name": "单候选不触发",
     "kind": "should_arbitrate",
     "decision": {"verdict": "probable", "ranking": [{"id": "a", "confidence": 0.6}]}, "expect": false},
    {"name": "insufficient 可触发",
     "kind": "should_arbitrate", "decision": {"verdict": "insufficient_evidence", "c1": 0.40, "c2": 0.35}, "expect": true},

    {"name": "合法引用通过", "kind": "cited_valid",
     "choice": "top1", "cited": [{"candidate": "top1", "feature": "cluster_crystal", "state": "IN_RANGE"}],
     "expect_valid": true},
    {"name": "choice 非法拒绝", "kind": "cited_valid",
     "choice": "top3", "cited": [{"candidate": "top1", "feature": "cluster_crystal", "state": "IN_RANGE"}],
     "expect_valid": false},
    {"name": "引用不存在候选拒绝", "kind": "cited_valid",
     "choice": "top2", "cited": [{"candidate": "top99", "feature": "cluster_crystal", "state": "IN_RANGE"}],
     "expect_valid": false},
    {"name": "state 不匹配拒绝", "kind": "cited_valid",
     "choice": "top1", "cited": [{"candidate": "top1", "feature": "cluster_crystal", "state": "OUT_OF_RANGE"}],
     "expect_valid": false},
    {"name": "feature 不存在拒绝", "kind": "cited_valid",
     "choice": "top1", "cited": [{"candidate": "top1", "feature": "nope", "state": "IN_RANGE"}],
     "expect_valid": false},
    {"name": "state 为空但 feature 存在可放宽", "kind": "cited_valid",
     "choice": "top2", "cited": [{"candidate": "top2", "feature": "cluster_crystal", "state": null}],
     "expect_valid": true},
    {"name": "cited 为空且 choice=tie 合法", "kind": "cited_valid",
     "choice": "tie", "cited": [], "expect_valid": true},
    {"name": "支持候选 display 名引用（非 top1/top2）", "kind": "cited_valid",
     "choice": "top1", "cited": [{"candidate": "候选一", "feature": "cluster_crystal", "state": "IN_RANGE"}],
     "expect_valid": true},
    {"name": "支持候选 id 引用", "kind": "cited_valid",
     "choice": "top2", "cited": [{"candidate": "cand2", "feature": "cluster_crystal", "state": "IN_RANGE"}],
     "expect_valid": true},

    {"name": "prompt 含两候选 id 与判据", "kind": "prompt_build",
     "decision": {"verdict": "probable", "c1": 0.60, "c2": 0.55},
     "expect_contains": ["候选一", "候选二", "cluster_crystal", "IN_RANGE"]},

    {"name": "正常仲裁 applied=True", "kind": "run_shadow",
     "decision": {"verdict": "probable", "c1": 0.60, "c2": 0.55},
     "client_result": {"ok": true, "raw": {"choice": "top1",
                        "cited": [{"candidate": "top1", "feature": "cluster_crystal", "state": "IN_RANGE"}]},
                        "error": null},
     "expect": {"applied": true, "status": "ok", "choice": "top1"}},
    {"name": "正常仲裁带 trigger.margin", "kind": "run_shadow_margin",
     "decision": {"verdict": "probable", "c1": 0.60, "c2": 0.55},
     "client_result": {"ok": true, "raw": {"choice": "top1",
                        "cited": [{"candidate": "top1", "feature": "cluster_crystal", "state": "IN_RANGE"}]},
                        "error": null},
     "expect_margin": 0.05},

    {"name": "client=None 返回 None", "kind": "run_shadow",
     "decision": {"verdict": "probable", "c1": 0.60, "c2": 0.55},
     "client_result": null, "expect": {"applied": false, "is_none": true}},
    {"name": "confirmed 不触发仲裁，client 不被调用", "kind": "run_shadow",
     "decision": {"verdict": "confirmed", "c1": 0.80, "c2": 0.75},
     "client_result": {"ok": true, "raw": {"choice": "top1",
                        "cited": [{"candidate": "top1", "feature": "cluster_crystal", "state": "IN_RANGE"}]},
                        "error": null},
     "expect": {"applied": false, "is_none": true, "calls": 0}},
    {"name": "引用不一致 → 建议作废", "kind": "run_shadow",
     "decision": {"verdict": "probable", "c1": 0.60, "c2": 0.55},
     "client_result": {"ok": true, "raw": {"choice": "top1",
                        "cited": [{"candidate": "top1", "feature": "ghost_feature", "state": "IN_RANGE"}],
                        "reason": "编造判据"}, "error": null},
     "expect": {"applied": true, "status": "invalid_reference"}},
    {"name": "LLM 失败 → 降级不中断", "kind": "run_shadow",
     "decision": {"verdict": "probable", "c1": 0.60, "c2": 0.55},
     "client_result": {"ok": false, "raw": {}, "error": "timeout"},
     "expect": {"applied": true, "status": "error"}}
  ]
}