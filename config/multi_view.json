{
  "allow_network": true,
  "a": {
    "mode": "cli",
    "required": true,
    "checkpoint_dir": "MICROSCOPE-main/v3_resnet50_full",
    "timeout_seconds": 180
  },
  "b": {
    "mode": "run",
    "input_mode": "images",
    "enable_vlm": false
  },
  "agent": {
    "mode": "active",
    "planner": "llm",
    "transport": "mcp",
    "max_steps": 40,
    "candidate_policy": {
      "top_k": 3
    },
    "workflow": {
      "execution": "active",
      "agent_policy": "adaptive_v2",
      "python": ".venv/vision/Scripts/python.exe",
      "detector": "yolo",
      "targeted_recovery": true,
      "max_parallel": 2,
      "locate_attempts_per_view": 2,
      "locate_attempt_reserve": 2,
      "max_tool_failures": 2,
      "identity_min_confidence": "medium",
      "max_seconds": 1800,
      "max_observation_seconds": 150,
      "max_call_seconds": 180,
      "initialization_reserve": 1,
      "max_planning": 32,
      "max_observations": 10,
      "max_recompute": 30,
      "max_api_calls": 60,
      "max_resource_units": 220,
      "quality_policy": "strict",
      "quality_evaluation": "legacy",
      "box_association": "region_component",
      "candidate_scope": "open_strict",
      "a_weight": 0.6,
      "b_weight": 0.4,
      "min_support_features": 2,
      "final_assessment_llm": true,
      "final_assessment_seconds": 45,
      "needle_audit": true,
      "feature_audit": true,
      "feature_audit_features": ["needle_crystal"],
      "image_exemplar_audit": false,
      "image_exemplar_bank": "TCM_Fusion/config/feature_exemplar_bank.json",
      "image_exemplar_positive": 4,
      "image_exemplar_negative": 4,
      "image_exemplar_seconds": 60,
      "needle_negative_hint": "不要将纤维（连续细胞壁、胞腔）、表皮细胞、花粉粒、其他结晶或纯组织区域当作针晶；只框可分辨的针晶。",
      "needle_positive_hint": "优先单根、细长、两端尖、透明或半透明、无连续细胞壁/胞腔的草酸钙针晶；成簇时只框可分辨的单根。",
      "screen_top_k": 2,
      "screen_concurrency": 3,
      "needle_scan_enabled": false,
      "needle_scan_tile_size": 1024,
      "needle_scan_overlap": 0.15,
      "needle_scan_max_tiles": 9,
      "needle_scan_concurrency": 2,
      "feature_scan_enabled": false,
      "feature_scan_features": [],
      "feature_scan_from_candidates": true,
      "feature_scan_max_features": 2,
      "feature_scan_tile_size": 1024,
      "feature_scan_overlap": 0.15,
      "feature_scan_max_tiles": 6,
      "feature_scan_concurrency": 2,
      "hybrid_scan_enabled": true,
      "hybrid_scan_max_features": 2,
      "feature_profiles": {
        "needle_crystal": {
          "positive": "优先单根、细长、两端尖、透明或半透明、无连续细胞壁/胞腔的草酸钙针晶；成簇时只框可分辨的单根。",
          "negative": ["纤维：连续细胞壁/胞腔", "表皮细胞：片状/多边形边界", "导管：管腔/环纹/网纹", "石细胞：厚壁/胞腔", "分泌组织：油室/油管/腔隙内容物", "簇晶/方晶/花粉粒仅作软负例"]
        },
        "fiber": {
          "negative": ["表皮细胞：片状/多边形边界", "导管：管腔/环纹/网纹", "石细胞：厚壁/胞腔", "分泌组织：油室/油管/腔隙"]
        },
        "epidermis_cell": {
          "negative": ["纤维：连续细胞壁/胞腔", "导管：管腔/环纹/网纹", "石细胞：厚壁/胞腔"]
        },
        "vessel": {
          "negative": ["纤维：连续细胞壁/胞腔", "表皮细胞：片状/多边形边界", "石细胞：厚壁/胞腔"]
        },
        "stone_cell": {
          "negative": ["纤维：连续细胞壁/胞腔", "表皮细胞：片状/多边形边界", "分泌组织：油室/油管/腔隙"]
        },
        "secretory_tissue": {
          "negative": ["纤维：连续细胞壁/胞腔", "石细胞：厚壁/胞腔", "未分类组织/背景"]
        }
      },
      "glm_identity_threshold": 0.8,
      "glm_locate_threshold": 0.8,
      "locate_expand": 1.5,
      "enabled_tools": [
        "detect_fov_initial",
        "calibrate_fov",
        "segment_instance",
        "classify_target",
        "measure_instances",
        "detect_region",
        "propose_regions",
        "roi_screen",
        "roi_screen_batch",
        "locate_feature",
        "needle_scan",
        "feature_scan",
        "hybrid_scan",
        "image_exemplar_audit"
      ]
    }
  },
  "aliases": {},
  "allow_recorded": false
}
