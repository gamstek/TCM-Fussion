{
  "allow_network": true,
  "a": {
    "mode": "cli",
    "required": true,
    "checkpoint_dir": "MICROSCOPE-main/v3_resnet50_full",
    "timeout_seconds": 180
  },
  "b": {
    "mode": "run",
    "input_mode": "images",
    "enable_vlm": false
  },
  "agent": {
    "mode": "active",
    "planner": "llm",
    "transport": "mcp",
    "max_steps": 40,
    "candidate_policy": {
      "top_k": 3
    },
    "workflow": {
      "execution": "active",
      "agent_policy": "adaptive_v2",
      "python": ".venv/vision/Scripts/python.exe",
      "detector": "yolo",
      "targeted_recovery": true,
      "max_parallel": 2,
      "locate_attempts_per_view": 2,
      "locate_attempt_reserve": 2,
      "max_tool_failures": 2,
      "identity_min_confidence": "medium",
      "max_seconds": 1800,
      "max_observation_seconds": 150,
      "max_call_seconds": 180,
      "initialization_reserve": 1,
      "max_planning": 32,
      "max_observations": 10,
      "max_recompute": 30,
      "max_api_calls": 60,
      "max_resource_units": 220,
      "quality_policy": "strict",
      "quality_evaluation": "legacy",
      "box_association": "region_component",
      "candidate_scope": "open_strict",
      "a_weight": 0.6,
      "b_weight": 0.4,
      "min_support_features": 2,
      "final_assessment_llm": true,
      "final_assessment_seconds": 45,
      "screen_top_k": 2,
      "screen_concurrency": 3,
      "glm_identity_threshold": 0.8,
      "glm_locate_threshold": 0.8,
      "locate_expand": 1.5,
      "enabled_tools": [
        "detect_fov_initial",
        "calibrate_fov",
        "segment_instance",
        "classify_target",
        "measure_instances",
        "detect_region",
        "propose_regions",
        "roi_screen",
        "roi_screen_batch",
        "locate_feature"
      ]
    }
  },
  "aliases": {},
  "allow_recorded": false
}
